# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database ----
# Local development uses SQLite (zero setup). The SQL in src/db/schema.sql is
# PostgreSQL-compatible as well (see /database/schema.postgres.sql).
DB_CLIENT=sqlite
SQLITE_FILE=./data/truckify.db

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Payments (SIMULATED - no real transaction is performed) ----
PAYMENT_MODE=simulated
